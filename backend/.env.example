PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-vercel-project.vercel.app
ALLOWED_ORIGINS=https://your-vercel-project.vercel.app

ADMIN_INITIAL_PASSWORD=replace_with_a_strong_password
ADMIN_EMAIL=contact@varshaagro.com
JWT_SECRET=replace_with_a_super_strong_cryptographic_secret_key

# Optional persistent storage and MongoDB configuration
# PERSISTENT_DATA_DIR=/var/data
# MONGODB_URI=mongodb+srv://...

# Optional email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=contact@varshaagro.com
# SMTP_PASS=your_app_password
# SMTP_FROM=VARSHA AGRO Inquiries <contact@varshaagro.com>
# NOTIFICATION_EMAIL=contact@varshaagro.com
