# ==============================================================
# VARSHA AGRO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================

# Server Network Settings
PORT=5000
NODE_ENV=production

# Custom Domain & Additional CORS Whitelist (comma-separated if multiple)
ALLOWED_ORIGINS=https://varshaagro.com,https://www.varshaagro.com,https://varsha-agro.onrender.com

# Admin Security & Authentication
# Change this on first deployment for secure admin access!
ADMIN_INITIAL_PASSWORD=VarshaAgro@2026
ADMIN_EMAIL=contact@varshaagro.com
JWT_SECRET=replace_with_a_super_strong_cryptographic_secret_key_minimum_32_characters

# Persistent Database & Storage Settings (Render / Cloud)
# On Render Web Service with a Persistent Disk mounted at /var/data:
# PERSISTENT_DATA_DIR=/var/data
# Or specify custom SQLite DB location:
# DATA_DIR=./server/data

# MongoDB Atlas Cloud Database URI (Permanent 100% Free Cloud Storage)
# Replace <db_password> with your MongoDB user password:
MONGODB_URI=mongodb+srv://onkarjadhavar23_db_user:<db_password>@cluster0.dsjeywo.mongodb.net/varsha_agro?retryWrites=true&w=majority&appName=Cluster0

# Lead Notification System (Instant Email per Inquiry)
# Options: SMTP (Hostinger/cPanel/Brevo/SendGrid) or Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@varshaagro.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM=VARSHA AGRO Inquiries <contact@varshaagro.com>
NOTIFICATION_EMAIL=contact@varshaagro.com

# Optional Lead Webhook Integration (Telegram, WhatsApp Bot, Slack, Zapier)
# ENQUIRY_WEBHOOK_URL=https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<ID>
